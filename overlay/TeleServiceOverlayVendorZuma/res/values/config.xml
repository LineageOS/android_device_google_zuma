<resources>
    <!-- Flag indicating whether the device supports RTT (real-time text) -->
    <bool name="config_support_rtt">true</bool>

    <!-- String indicating the package name of the device ImsService implementation for MMTEL. -->
    <string name="config_ims_mmtel_package">com.shannon.imsservice</string>

    <!-- String indicating the package name of the device ImsService implementation for RCS. -->
    <string name="config_ims_rcs_package">com.shannon.rcsservice</string>

    <!-- String indicating the package name of the device GbaService implementation. -->
    <string name="config_gba_package">com.shannon.rcsservice</string>

    <!-- The processes names of the logcat logs that will be collected after an emergency call.-->
    <string-array name="ecc_log_sources_process_names">
        <item>com.android.phone</item>
        <item>com.android.telephony.imsmedia</item>
        <item>com.shannon.imsservice</item>
        <item>com.android.qns</item>
        <item>com.google.android.iwlan</item>
        <item>rild_exynos</item>
        <item>com.samsung.slsi.telephony.oemril</item>
        <item>com.google.android.rilextension</item>
        <item>com.samsung.slsi.telephony.oem.oemrilhookservice</item>
        <item>com.google.android.dialer</item>
        <item>com.android.settings</item>
    </string-array>
</resources>
